# Copy to .env and fill in. .env is gitignored -- never commit real values.

# Your Kalshi API key ID (UUID shown when you create the key in the Kalshi UI).
KALSHI_API_KEY_ID=00000000-0000-0000-0000-000000000000

# Absolute path to the RSA private key file downloaded when the key was created.
# PEM format. Keep it outside the repo, or name it so .gitignore catches it.
KALSHI_API_KEY_PATH=C:\path\to\your\kalshi_private_key.pem
